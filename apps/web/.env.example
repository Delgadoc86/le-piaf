# Copiá este archivo a .env.local. Con estos valores la app usa los EMULADORES (proyecto demo-mimenu).
# Para mimenu-dev / mimenu-prod, completá con los datos de la app web registrada en Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mimenu.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mimenu
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-mimenu.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
NEXT_PUBLIC_USE_EMULATORS=true
# Solo servidor (Admin SDK): JSON de la cuenta de servicio en base64. Vacío con emuladores.
FIREBASE_SERVICE_ACCOUNT_JSON=
REVALIDATE_SECRET=cambiar-en-dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
