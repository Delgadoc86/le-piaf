# Copiá este archivo a .env.local. Con estos valores la app usa los EMULADORES (proyecto demo-local).
# Nombre del local (lo usan el login, el panel y el título hasta la Fase 1).
NEXT_PUBLIC_NOMBRE_LOCAL=Silverio Club
# Para el proyecto real (silverio-club), completá con los datos de la app web registrada en Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
NEXT_PUBLIC_USE_EMULATORS=true
# Solo servidor (Admin SDK): JSON de la cuenta de servicio en base64. Vacío con emuladores.
FIREBASE_SERVICE_ACCOUNT_JSON=
REVALIDATE_SECRET=cambiar-en-dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
