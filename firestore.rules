rules_version = '2';

// Reglas de Firestore v1 (ROADMAP §7). Un repo = un local: todo cuelga de la raíz.
// Denegar por defecto. Todo lo que no está explícitamente permitido, no se puede.
// Cada regla tiene su test en tests/reglas/firestore.test.ts.

service cloud.firestore {
  match /databases/{db}/documents {

    // ─── Helpers de sesión y roles (custom claim: { rol }) ───

    function signedIn() { return request.auth != null; }
    function rol() { return signedIn() ? request.auth.token.get('rol', null) : null; }
    function esDueno() { return rol() == 'dueno'; }
    function esGestor() { return rol() in ['dueno', 'encargado']; }
    function esStaff() { return rol() in ['dueno', 'encargado', 'mozo', 'cocina']; }

    // ─── Helpers de validación ───

    function cambios() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function soloCambia(campos) { return cambios().hasOnly(campos); }
    function datos() { return request.resource.data; }
    function esPesos(v) { return v is int && v >= 0; }
    function esTextoCorto(v) { return v is string && v.size() > 0 && v.size() <= 80; }

    // ─── Local ───

    // local/datos: marca, contacto, horarios, contenido web, config de pedidos y pagos.
    match /local/{doc} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if doc == 'datos' && esDueno()
        && datos().activo is bool
        && esTextoCorto(datos().nombre);
    }

    // Perfil técnico (claimsVersion): cada uno lee el suyo; solo lo escriben las Functions.
    match /usuarios/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Equipo: lo crea invitarMiembro. El dueño puede cambiar rol/nombre/activo de otros,
    // nunca crear otro dueño ni tocarse a sí mismo (así el local no se queda sin dueño).
    match /miembros/{uid} {
      allow read: if esGestor() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if false;
      allow update: if esDueno()
        && request.auth.uid != uid
        && resource.data.rol != 'dueno'
        && soloCambia(['rol', 'nombre', 'activo'])
        && datos().rol in ['encargado', 'mozo', 'cocina']
        && datos().activo is bool;
    }

    // Tokens de Mercado Pago del local: nunca desde el cliente.
    match /privado/{doc} {
      allow read, write: if false;
    }

    // ─── Carta (lectura pública) ───

    match /categorias/{id} {
      allow read: if true;
      allow delete: if esGestor();
      allow create, update: if esGestor()
        && datos().keys().hasOnly(['nombre', 'orden', 'visible', 'icono', 'descripcion'])
        && esTextoCorto(datos().nombre)
        && datos().orden is int
        && datos().visible is bool;
    }

    match /productos/{id} {
      allow read: if true;
      allow delete: if esGestor();
      allow create: if esGestor() && productoValido();
      // Gestores editan todo; cualquier miembro del staff puede marcar "Agotado".
      allow update: if (esGestor() && productoValido())
        || (esStaff() && soloCambia(['disponible', 'actualizadoEn']) && datos().disponible is bool);

      function productoValido() {
        return datos().keys().hasOnly(['categoriaId', 'nombre', 'descripcion', 'precio', 'fotoUrl',
            'orden', 'visible', 'disponible', 'diasDisponible', 'estacion', 'etiquetas',
            'variantes', 'gruposExtras', 'actualizadoEn'])
          && datos().keys().hasAll(['categoriaId', 'nombre', 'precio', 'orden', 'visible',
            'disponible', 'estacion'])
          && esTextoCorto(datos().nombre)
          && datos().categoriaId is string
          && esPesos(datos().precio)
          && datos().orden is int
          && datos().visible is bool
          && datos().disponible is bool
          && datos().estacion in ['cocina', 'barra'];
      }
    }

    match /promos/{id} {
      allow read: if true;
      allow delete: if esGestor();
      allow create, update: if esGestor()
        && datos().keys().hasOnly(['titulo', 'descripcion', 'precio', 'fotoUrl', 'orden', 'activa',
            'items', 'vigencia'])
        && esTextoCorto(datos().titulo)
        && esPesos(datos().precio)
        && datos().orden is int
        && datos().activa is bool;
    }

    match /zonasDelivery/{id} {
      allow read: if true;
      allow delete: if esGestor();
      allow create, update: if esGestor()
        && datos().keys().hasOnly(['nombre', 'costo', 'pedidoMinimo', 'activa', 'orden'])
        && esTextoCorto(datos().nombre)
        && esPesos(datos().costo)
        && (!('pedidoMinimo' in datos()) || esPesos(datos().pedidoMinimo))
        && datos().activa is bool
        && datos().orden is int;
    }

    // ─── Salón ───

    // No es pública: el qrToken es lo que evita pedidos falsos desde casa.
    match /mesas/{id} {
      allow read: if esStaff();
      allow delete: if esGestor();
      allow create, update: if esGestor()
        && datos().keys().hasOnly(['nombre', 'sector', 'capacidad', 'orden', 'estado',
            'pedidoActualId', 'qrToken'])
        && esTextoCorto(datos().nombre)
        && datos().capacidad is int
        && datos().estado in ['libre', 'ocupada', 'cuenta'];
      // El mozo cambia el estado de la mesa desde el salón.
      allow update: if rol() == 'mozo'
        && soloCambia(['estado', 'pedidoActualId'])
        && datos().estado in ['libre', 'ocupada', 'cuenta'];
    }

    // ─── Pedidos ───

    // Nadie los crea ni borra desde el cliente: los crea crearPedido (Admin SDK).
    // El staff solo toca los campos operativos; precios, totales y número son inmutables.
    match /pedidos/{id} {
      allow read: if esStaff();
      allow create, delete: if false;
      allow update: if datos().estado in ['pendiente', 'aceptado', 'en_preparacion', 'listo',
            'en_camino', 'entregado', 'rechazado', 'cancelado', 'abierto', 'cuenta_pedida', 'cerrado']
        && envioCoherente()
        && confirmacionCoherente()
        && (
          (esGestor() && soloCambia(camposGestion()))
          || (rol() == 'mozo'
              && (resource.data.tipo == 'salon' || resource.data.get('mozoUid', null) == request.auth.uid)
              && soloCambia(camposGestion()))
          || (rol() == 'cocina' && soloCambia(['items', 'historial', 'actualizadoEn']))
        );

      function camposGestion() {
        return ['estado', 'items', 'pagos', 'estadoPago', 'tiempoEstimadoMin', 'motivoCancelacion',
                'historial', 'actualizadoEn', 'comensales', 'costoEnvio', 'total', 'porConfirmar',
                'confirmarAntesDe', 'canceladoPor'];
      }

      // Pedidos de clientes nuevos: el staff solo puede confirmarlos (nunca volver a "sin confirmar"),
      // borrar el vencimiento y marcar que la cancelación fue del local. El resto lo hacen Functions.
      function confirmacionCoherente() {
        return (!cambios().hasAny(['porConfirmar']) || datos().porConfirmar == false)
          && (!cambios().hasAny(['confirmarAntesDe']) || !('confirmarAntesDe' in datos()))
          && (!cambios().hasAny(['canceladoPor']) || datos().canceladoPor == 'local');
      }

      // El envío (delivery sin zonas) lo confirma el local: solo en delivery y con el total bien
      // calculado. Los precios de los ítems, el subtotal y el descuento no se tocan nunca.
      function envioCoherente() {
        return !cambios().hasAny(['costoEnvio', 'total'])
          || (resource.data.tipo == 'delivery'
              && esPesos(datos().costoEnvio)
              && datos().total == datos().subtotal - datos().descuento + datos().costoEnvio);
      }
    }

    // Números que no pueden pedir por la web (los revisa crearPedido). Solo dueño y encargado.
    match /bloqueados/{telefono} {
      allow read, delete: if esGestor();
      allow create, update: if esGestor()
        && datos().keys().hasOnly(['telefono', 'motivo', 'porUid', 'en'])
        && datos().telefono == telefono
        && telefono.matches('^[0-9]{8,15}$')
        && datos().motivo is string && datos().motivo.size() <= 120
        && datos().porUid == request.auth.uid
        && datos().en == request.time;
    }

    // Espejo público mínimo para /pedido/[token]: get sí, list nunca.
    match /seguimiento/{token} {
      allow get: if true;
      allow list, write: if false;
    }

    match /contadores/{dia} {
      allow read, write: if false;
    }

    match /clientes/{telefono} {
      allow read: if esGestor();
      allow write: if false;
    }

    // ─── Caja ───

    // Abrir, cerrar y totalizar turnos lo hacen Functions (un solo turno abierto a la vez).
    match /turnosCaja/{turnoId} {
      allow read: if esGestor();
      allow write: if false;

      // Los movimientos (gastos, retiros, cambio) no se editan ni se borran: quedan como registro.
      match /movimientos/{movId} {
        allow read: if esGestor();
        allow create: if esGestor()
          && datos().keys().hasOnly(['tipo', 'categoria', 'monto', 'detalle', 'porUid', 'en'])
          && datos().tipo in ['ingreso', 'egreso']
          && datos().categoria in ['proveedor', 'cambio', 'retiro', 'otro']
          && esPesos(datos().monto) && datos().monto > 0
          && datos().detalle is string && datos().detalle.size() <= 200
          && datos().porUid == request.auth.uid
          && datos().en == request.time
          // Solo en la caja abierta: un cierre no se modifica después.
          && get(/databases/$(db)/documents/turnosCaja/$(turnoId)).data.estado == 'abierto';
        allow update, delete: if false;
      }
    }

    // ─── Solo Functions escriben ───

    match /statsDiarias/{dia} {
      allow read: if esGestor();
      allow write: if false;
    }

    match /auditoria/{id} {
      allow read: if esDueno();
      allow write: if false;
    }
  }
}
